# Optional local LLM adapter. Demo mode needs neither setting.
# Pull a suitable instruction-following model with Ollama, then set its exact name.
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Optional hosted trace export. Leave false for local-only operation.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentloop-studio
# This file documents settings; the application reads environment variables.
# It does not load .env files automatically.
